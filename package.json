{
  "name": "harnessx",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run build && npm run test --workspaces --if-present",
    "check": "npm run test",
    "test:live": "npm run build && node scripts/live-ollama-smoke.js",
    "test:extension": "npm run build && node scripts/test-vscode.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vscode/test-electron": "^3.1.0",
    "typescript": "^5.7.3"
  }
}
